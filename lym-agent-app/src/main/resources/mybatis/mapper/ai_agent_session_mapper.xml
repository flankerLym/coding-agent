<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.lym.ai.infrastructure.dao.IAgentSessionDao">

    <resultMap id="agentSessionMap" type="com.lym.ai.infrastructure.dao.po.AgentSessionPO">
        <id column="id" property="id"/>
        <result column="session_id" property="sessionId"/>
        <result column="user_id" property="userId"/>
        <result column="title" property="title"/>
        <result column="initial_question" property="initialQuestion"/>
        <result column="session_status" property="sessionStatus"/>
        <result column="ext_info" property="extInfo"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.lym.ai.infrastructure.dao.po.AgentSessionPO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO agent_session (
            session_id,
            user_id,
            title,
            initial_question,
            session_status,
            ext_info,
            create_time,
            update_time
        ) VALUES (
                     #{sessionId},
                     #{userId},
                     #{title},
                     #{initialQuestion},
                     #{sessionStatus},
                     #{extInfo},
                     #{createTime},
                     #{updateTime}
                 )
    </insert>

    <select id="queryByUserId" resultMap="agentSessionMap">
        SELECT
            id,
            session_id,
            user_id,
            title,
            session_status,
            ext_info,
            create_time,
            update_time
        FROM agent_session
        WHERE user_id = #{userId}
        ORDER BY update_time DESC, id DESC
    </select>

    <select id="queryBySessionId" resultMap="agentSessionMap">
        SELECT
            id,
            session_id,
            user_id,
            title,
            session_status,
            ext_info,
            create_time,
            update_time
        FROM agent_session
        WHERE session_id = #{sessionId}
    </select>

    <select id="lockBySessionId" resultType="java.lang.String">
        SELECT session_id
        FROM agent_session
        WHERE session_id = #{sessionId}
            FOR UPDATE
    </select>

</mapper>